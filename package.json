{
  "name": "afterbeat",
  "private": true,
  "version": "1.0.0",
  "description": "AFTERBEAT - rhythm tactics roguelike where your echo replays your last bar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "art": "node scripts/build-art.mjs"
  },
  "dependencies": {
    "galmuri": "2.40.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
